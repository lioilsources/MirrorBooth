# Copy to pipeline/.env and fill in. Never commit .env.

# --- LLM provider ------------------------------------------------------------
# spark (default) = OpenAI-compatible LiteLLM gateway on SPARK; anthropic = optional cloud fallback.
LLM_PROVIDER=spark
# Provider for the `vision` role only (preview ranker, Phase 5). Empty = same as LLM_PROVIDER.
# LLM_PROVIDER_VISION=spark

# --- SPARK / LiteLLM gateway ---------------------------------------------------
# The old default :8000 + model "llama3" is dead; everything goes through LiteLLM on :8080.
SPARK_BASE_URL=http://192.168.88.66:8080/v1
# LiteLLM alias. LLMs run only in the SPARK window llm 17:00-01:00:
#   openclaw-default = qwen36 (coder + vision), bench-nano = Nano-30B (faster coder)
SPARK_MODEL=openclaw-default
# LiteLLM requires `Authorization: Bearer <key>` — put the gateway (master/virtual) key here.
SPARK_API_KEY=dummy

# Vision model for the preview ranker (qwen36 sees images). Key defaults to SPARK_API_KEY.
SPARK_VISION_BASE_URL=http://192.168.88.66:8080/v1
SPARK_VISION_MODEL=openclaw-default
# SPARK_VISION_API_KEY=

# --- Anthropic (optional) --------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Shadertoy (Phase 1+) ----------------------------------------------------------
# Create an app key at https://www.shadertoy.com/myapps
SHADERTOY_API_KEY=

# --- Flutter SDK for impellerc validation (Phase 4) ---------------------------------
# FLUTTER_ROOT=$(dirname $(dirname $(which flutter)))  — write the resolved absolute path
FLUTTER_ROOT=

# --- Tuning (defaults shown) ---------------------------------------------------------
# MAX_RETRIES=3
# RAG_TOP_K=5
# PERF_MAX_LOOP_FETCH_BUDGET=64
# PERF_MAX_LOOP_DEPTH=2
# PERF_RAYMARCH_WARN_STEPS=48
# PERF_RAYMARCH_MAX_STEPS=96
# PREVIEW_ENABLED=true
